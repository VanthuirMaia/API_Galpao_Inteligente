# Galpão Inteligente - variáveis de ambiente (copie para .env e ajuste)

# Host do broker MQTT (no compose, o nome do serviço)
MQTT_HOST=mosquitto
# Porta do broker
MQTT_PORT=1883
# Usuário MQTT do ingestor (precisa existir no passwd do Mosquitto)
MQTT_USER=ingestor
# Senha do ingestor
MQTT_PASS=troque-esta-senha
# Identificador do cliente; fixo, para a sessão persistente (QoS 1) funcionar
MQTT_CLIENT_ID=galpao-ingestor
# Tópico assinado (+ = qualquer device_id)
MQTT_TOPICO=galpao/+/leituras

# URL do PostgreSQL (em dev o overlay sobrescreve esta variável)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Validade do cache de dispositivos ativos, em segundos
CACHE_TTL_S=300
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# (API) Segundos sem receber leitura para um dispositivo deixar de aparecer como online
ONLINE_LIMITE_S=300

# (API) URL do Postgres da role galpao_api; em dev o overlay sobrescreve. Tem prioridade sobre DATABASE_URL
# (ingestor e API compartilham este .env e usam roles diferentes)
DATABASE_URL_API=postgresql://galpao_api:senha@host:5432/galpao
# (API) Segredo do JWT, mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
# (API) Validade do token, em minutos
JWT_EXPIRA_MIN=480
# (API) Prefixo onde um proxy publica a API (vazio em dev)
ROOT_PATH=
# (API) Origens permitidas no CORS, separadas por vírgula (vazio = sem CORS)
CORS_ORIGINS=
