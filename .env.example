# Galpão Inteligente - variáveis de ambiente (copie para .env e ajuste)

# Host do broker MQTT (no compose, o nome do serviço)
MQTT_HOST=mosquitto
# Porta do broker
MQTT_PORT=1883
# Usuário MQTT do ingestor (precisa existir no passwd do Mosquitto)
MQTT_USER=ingestor
# Senha do ingestor
MQTT_PASS=troque-esta-senha
# Identificador do cliente; fixo, para a sessão persistente (QoS 1) funcionar
MQTT_CLIENT_ID=galpao-ingestor
# Tópico assinado (+ = qualquer device_id)
MQTT_TOPICO=galpao/+/leituras

# URL do PostgreSQL (em dev o overlay sobrescreve esta variável)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Validade do cache de dispositivos ativos, em segundos
CACHE_TTL_S=300
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
