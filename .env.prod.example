# Galpão Inteligente - produção (copie para .env e preencha os placeholders)

# Broker na própria VPS: o ingestor usa network_mode host e a porta 1883 publicada
MQTT_HOST=127.0.0.1
# Porta do broker
MQTT_PORT=1883
# Usuário MQTT do ingestor (criado com scripts/criar_usuario_mqtt.sh)
MQTT_USER=ingestor
# Senha MQTT do ingestor (a mesma informada no script de criação do usuário)
MQTT_PASS=TROQUE_SENHA_MQTT_INGESTOR
# Identificador do cliente; fixo, para a sessão persistente (QoS 1) funcionar
MQTT_CLIENT_ID=galpao-ingestor
# Tópico assinado (+ = qualquer device_id)
MQTT_TOPICO=galpao/+/leituras

# Postgres do host, com a role galpao_ingestor (senha definida com ALTER ROLE)
DATABASE_URL=postgresql://galpao_ingestor:SENHA@localhost:5432/galpao

# Validade do cache de dispositivos ativos, em segundos
# (um ESP recém-cadastrado leva até este tempo para ser aceito)
CACHE_TTL_S=300
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# (API) Segundos sem receber leitura para um dispositivo deixar de aparecer como online
ONLINE_LIMITE_S=300
