# Galpão Inteligente - produção (copie para .env e preencha os placeholders)
# Segredos: gere cada um com `openssl rand -hex 24` (só hex, para não quebrar as URLs do Postgres)

# --- Banco (Postgres em container; criado do zero na primeira subida) ---
# Senha do superusuário "galpao" do Postgres
POSTGRES_PASSWORD=TROQUE_openssl_rand_hex_24
# Senha da role galpao_ingestor (definida pelo db/900_senhas_roles.sh)
PG_SENHA_INGESTOR=TROQUE_openssl_rand_hex_24
# Senha da role galpao_api (definida pelo db/900_senhas_roles.sh)
PG_SENHA_API=TROQUE_openssl_rand_hex_24

# --- Ingestor / MQTT ---
# Broker: o serviço mosquitto do compose
MQTT_HOST=mosquitto
# Porta do broker
MQTT_PORT=1883
# Usuário MQTT do ingestor (criado com scripts/criar_usuario_mqtt.sh)
MQTT_USER=ingestor
# Senha MQTT do ingestor (a mesma informada no script de criação do usuário)
MQTT_PASS=TROQUE_SENHA_MQTT_INGESTOR
# Identificador do cliente; fixo, para a sessão persistente (QoS 1) funcionar
MQTT_CLIENT_ID=galpao-ingestor
# Tópico assinado (+ = qualquer device_id)
MQTT_TOPICO=galpao/+/leituras
# Validade do cache de dispositivos ativos, em segundos (ESP novo leva até este tempo para ser aceito)
CACHE_TTL_S=300
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- API / painel (publicados pelo Traefik) ---
# Domínio público (DNS apontando para a VPS); o MQTT dos ESPs é mqtt.<domínio>
DOMINIO=etenexus.tech
# Segredo do JWT, mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_openssl_rand_hex_32
# Validade do token, em minutos
JWT_EXPIRA_MIN=480
# Origens permitidas no CORS, separadas por vírgula (vazio = sem CORS)
CORS_ORIGINS=
# Segundos sem leitura para um dispositivo deixar de aparecer como online
ONLINE_LIMITE_S=300

# As URLs do banco (DATABASE_URL, DATABASE_URL_API) e ROOT_PATH são montadas pelo docker-compose.prod.yml.
